{
  "name": "fatfish-air",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "肥鱼 Air：面向 JetBrains Air 的 Windows 桌宠，支持任务提醒、中文互动与 Codex 用量/额度提示。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "audit:upstream": "node scripts/audit-upstream.mjs --test",
    "install:local": "node scripts/install.mjs",
    "uninstall:local": "node scripts/install.mjs --undo",
    "status": "node scripts/install.mjs --status && node scripts/install-touch.mjs --status",
    "install:touch": "node scripts/install-touch.mjs",
    "uninstall:touch": "node scripts/install-touch.mjs --undo",
    "prepare:upstream": "node scripts/prepare-upstream.mjs",
    "pretest": "node scripts/prepare-test.mjs",
    "test:install": "node scripts/test-install.mjs",
    "configure:animations": "node scripts/configure-work-animations.mjs && node scripts/configure-attention.mjs && node scripts/configure-dialogue-animations.mjs",
    "configure:persona": "node scripts/configure-persona.mjs",
    "restore:persona": "node scripts/configure-persona.mjs --undo"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jtheller/fatfish-air.git",
    "directory": "integrations/jetbrains-air"
  },
  "homepage": "https://github.com/jtheller/fatfish-air#readme",
  "bugs": {
    "url": "https://github.com/jtheller/fatfish-air/issues"
  },
  "keywords": [
    "jetbrains-air",
    "desktop-pet",
    "fatfish",
    "codex",
    "windows",
    "dsh-pet"
  ]
}
